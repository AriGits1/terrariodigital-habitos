// Terrario Digital — Prisma schema
// CC451 Interaccion Humano Computador — PC3
//
// Database: PostgreSQL (dev and production). Local dev runs Postgres via
// docker-compose.yml; the connection URL comes from DATABASE_URL.
//
// Note: status fields are modeled as String with documented allowed values
// rather than native enums, kept for portability and simpler migrations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  // Prisma 7: the connection URL lives in prisma.config.ts (read from env).
  provider = "postgresql"
}

/// The single local user profile for the MVP. Drives biome personalization.
/// Auth fields (email, passwordHash, role) are nullable for zero-downtime migration.
model Profile {
  id            String   @id @default(cuid())
  name          String
  /// Preferred biome: "forest" | "desert" | "zen". Adapts to emotional profile.
  biomeType     String   @default("forest")
  /// Accessibility / interaction toggles.
  voiceEnabled  Boolean  @default(true)
  hapticsEnabled Boolean @default(true)
  onboarded     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// Auth fields — nullable so existing rows survive migration without backfill.
  email        String?  @unique
  passwordHash String?
  role         String   @default("user")

  /// Opt-in: when true, this profile is visible in the cohort and its terrarium is visitable.
  shareTerrarium Boolean @default(false)
  seeds          Int      @default(0)
  /// Water balance: bought with seeds in the Tienda or claimed from community gestures. Feeds the river and waters the biome.
  water          Int      @default(0)
  currentStreak  Int      @default(0)
  lastActiveDate DateTime?

  habits       Habit[]
  moodEntries  MoodEntry[]
  messages     ChatMessage[]
  sessions     MindfulnessSession[]
  biome        BiomeState?
  adaptation   AdaptationState?
  authSessions Session[]
  decorations  BiomeDecoration[]
  subscriptions PushSubscription[]

  sentEncouragements     Encouragement[] @relation("EncouragementFrom")
  receivedEncouragements Encouragement[] @relation("EncouragementTo")
}

/// DB-backed opaque session. Cookie carries only the token; profile is resolved server-side.
model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  profileId String
  expiresAt DateTime
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

/// A trackable habit (RF-01). Weight expresses relative importance for the
/// biome growth/degradation engine.
model Habit {
  id          String   @id @default(cuid())
  profileId   String
  title       String
  /// Optional plant/species this habit maps to inside the biome.
  species     String?
  /// Relative weight 1-5; heavier habits move the biome more.
  weight      Int      @default(1)
  /// "daily" | "weekly". How often the habit is expected.
  periodicity String   @default("daily")
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())

  profile Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  logs    HabitLog[]

  @@index([profileId])
}

/// One completion record for a habit on a given day. Drives gamification:
/// completions grow the biome, missed days degrade it.
model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  /// Calendar day (midnight) this log refers to.
  date      DateTime
  completed Boolean  @default(true)
  createdAt DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([habitId])
}

/// Morning diary entry (RF-04/RF-05). Captured via voice, text, or mood card.
/// `mood` and `score` are inferred by the LLM (Terapeuta de Bienestar).
model MoodEntry {
  id        String   @id @default(cuid())
  profileId String
  date      DateTime @default(now())
  /// "voice" | "text" | "card" — multimodal input source (RF-14).
  source    String   @default("text")
  /// Raw transcript or typed text.
  rawText   String?
  /// LLM-inferred label, e.g. "calm", "anxious", "motivated".
  mood      String?
  /// Normalized valence -1.0 (negative) .. 1.0 (positive).
  score     Float?
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

/// Snapshot of the living ecosystem. Derived from habit logs but cached here
/// so the 3D renderer can read a single source of truth quickly (RNF-01).
model BiomeState {
  id        String   @id @default(cuid())
  profileId String   @unique
  /// "forest" | "desert" | "zen".
  type      String   @default("forest")
  /// 0-100 overall growth/lushness.
  growth    Int      @default(20)
  /// 0-100 health; drops with missed habits, raised by completions.
  health    Int      @default(80)
  updatedAt DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

/// Per-user adaptation model (continuous personalization). One row per profile.
/// EWMA maps are stored as JSON-encoded text (SQLite has no JSON type) and
/// validated at the app layer by parseAdaptationState() in adaptation/state.ts.
model AdaptationState {
  id        String  @id @default(cuid())
  profileId String  @unique

  /// JSON text: Record<habitId, number> — per-habit completion EWMA (0..1).
  habitEwma        String @default("{}")
  /// Scalar mood valence EWMA (-1..1).
  moodEwma         Float  @default(0)
  /// JSON text: Record<ModuleKey, number> — per-module engagement EWMA (0..1).
  engagementEwma   String @default("{}")

  /// Human-readable transparency string for "¿por qué veo esto?". Nullable until first compute.
  adaptationReason String?

  /// Override: JSON text ModuleKey[] | null. When set, getModuleOrder
  /// is bypassed and this fixed order wins over the engine.
  moduleOrderOverride String?
  /// Override: when true, the engine NEVER auto-suggests difficulty changes.
  difficultyOverride  Boolean @default(false)

  updatedAt DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

/// A message in a conversation with one of the two LLM agents.
model ChatMessage {
  id        String   @id @default(cuid())
  profileId String
  /// "coach" (Productividad) | "therapist" (Bienestar).
  agent     String
  /// "user" | "assistant".
  role      String
  content   String
  createdAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, agent])
}

/// A completed mindfulness session with haptic guidance (RF-15).
model MindfulnessSession {
  id          String   @id @default(cuid())
  profileId   String
  durationSec Int
  completedAt DateTime @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

/// Async cooperative signal sent from one cohort member to another.
/// type = "water" | "kudos" (SQLite has no enums — documented String).
model Encouragement {
  id            String   @id @default(cuid())
  fromProfileId String
  toProfileId   String
  /// "water" (quick gesture) | "kudos" (optionally LLM-suggested message).
  type          String
  /// Optional free-text note; null for a bare "water".
  message       String?
  read          Boolean  @default(false)
  /// For type="water": whether the recipient has claimed the water into their balance. Idempotency guard.
  claimed       Boolean  @default(false)
  createdAt     DateTime @default(now())

  fromProfile Profile @relation("EncouragementFrom", fields: [fromProfileId], references: [id], onDelete: Cascade)
  toProfile   Profile @relation("EncouragementTo",   fields: [toProfileId],   references: [id], onDelete: Cascade)

  /// Inbox query: recipient's unread-first feed.
  @@index([toProfileId, read])
  @@index([fromProfileId])
}

/// User-placed visual decoration elements.
model BiomeDecoration {
  id        String   @id @default(cuid())
  profileId String
  type      String
  x         Float
  z         Float
  createdAt DateTime @default(now())

  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

/// Web Push Notification subscriptions.
model PushSubscription {
  id        String   @id @default(cuid())
  profileId String
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}
